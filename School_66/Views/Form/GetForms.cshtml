@using School_66.Entities
@{
    ViewData["Title"] = "Мої запити";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model List<StudentForm>

<div class="container my-5">
    <h2 class="mb-4 text-center text-primary fw-bold">
        <i class="bi bi-inbox"></i> Мої запити
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            У вас ще немає створених запитів 📨
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered table-hover align-middle shadow-sm">
            <thead class="table-dark text-center">
                <tr>
                    <th>#</th>
                    <th>Заголовок</th>
                    <th>Тип</th>
                    <th>Дата</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr class="text-center">
                        <td>@request.Id</td>
                        <td>@request.Title</td>
                        <td>@request.Type</td>
                        <td>@request.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            @switch (request.Status)
                            {
                                case "Новий":
                                    <span class="badge bg-primary">@request.Status</span>;
                                    break;
                                case "Обробляється":
                                    <span class="badge bg-warning text-dark">@request.Status</span>;
                                    break;
                                case "Виконано":
                                    <span class="badge bg-success">@request.Status</span>;
                                    break;
                                default:
                                    <span class="badge bg-secondary">@request.Status</span>;
                                    break;
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>