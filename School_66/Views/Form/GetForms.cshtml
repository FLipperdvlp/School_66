@using School_66.Entities
@{
    ViewData["Title"] = "Мої запити";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model List<StudentForm>

<div class="container my-5">
    <!-- Заголовок страницы -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="page-header text-center">
                <i class="bi bi-inbox-fill text-primary fs-1 mb-3 d-block"></i>
                <h1 class="display-5 fw-bold text-primary mb-2">Мої запити</h1>
                <p class="text-muted fs-5">Перегляд та відстеження статусу ваших звернень</p>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <!-- Пустое состояние -->
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="empty-state text-center p-5 bg-light rounded-4 shadow-sm">
                    <div class="empty-icon mb-4">
                        <i class="bi bi-envelope-open text-primary" style="font-size: 5rem; opacity: 0.3;"></i>
                    </div>
                    <h3 class="mb-3 fw-bold">Запитів поки немає</h3>
                    <p class="text-muted fs-5 mb-4">У вас ще немає створених запитів. Створіть перший запит, щоб побачити його тут.</p>
                    <a href="#" class="btn btn-primary btn-lg px-5 rounded-pill">
                        <i class="bi bi-plus-circle me-2"></i>Створити запит
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Таблица -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0 requests-table">
                    <thead>
                        <tr>
                            <th scope="col" class="text-center" style="width: 80px;">
                                <i class="bi bi-hash me-1"></i>ID
                            </th>
                            <th scope="col" style="min-width: 250px;">
                                <i class="bi bi-file-text me-1"></i>Заголовок
                            </th>
                            <th scope="col" class="text-center" style="width: 180px;">
                                <i class="bi bi-tag me-1"></i>Тип
                            </th>
                            <th scope="col" class="text-center" style="width: 150px;">
                                <i class="bi bi-calendar3 me-1"></i>Дата
                            </th>
                            <th scope="col" class="text-center" style="width: 150px;">
                                <i class="bi bi-flag me-1"></i>Статус
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            <tr class="request-row">
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border fw-semibold">#@request.Id</span>
                                </td>
                                <td>
                                    <div class="request-title fw-semibold text-dark">
                                        @request.Title
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="text-muted">@request.Type</span>
                                </td>
                                <td class="text-center">
                                    <span class="text-muted">
                                        <i class="bi bi-calendar-event me-1"></i>@request.CreatedAt.ToString("dd.MM.yyyy")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @switch (request.Status)
                                    {
                                        case "Новий":
                                            <span class="badge status-badge status-new">
                                                <i class="bi bi-circle-fill me-1"></i>@request.Status
                                            </span>
                                            break;
                                        case "Обробляється":
                                            <span class="badge status-badge status-processing">
                                                <i class="bi bi-arrow-repeat me-1"></i>@request.Status
                                            </span>
                                            break;
                                        case "Виконано":
                                            <span class="badge status-badge status-completed">
                                                <i class="bi bi-check-circle-fill me-1"></i>@request.Status
                                            </span>
                                            break;
                                        default:
                                            <span class="badge status-badge status-default">
                                                <i class="bi bi-dash-circle me-1"></i>@request.Status
                                            </span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Подсчет запросов -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="text-center text-muted">
                    <small>
                        <i class="bi bi-info-circle me-1"></i>
                        Всього запитів: <strong>@Model.Count</strong>
                    </small>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Заголовок страницы */
    .page-header {
        padding: 2rem 0;
    }

    /* Таблица */
    .requests-table {
        font-size: 0.95rem;
    }

    .requests-table thead {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .requests-table thead th {
        padding: 1.2rem 1.5rem;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        border: none;
        vertical-align: middle;
    }

    .requests-table tbody td {
        padding: 1.2rem 1.5rem;
        vertical-align: middle;
        border-bottom: 1px solid #e9ecef;
    }

    .requests-table tbody tr:last-child td {
        border-bottom: none;
    }

    /* Эффект при наведении на строку */
    .request-row {
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .request-row:hover {
        background-color: #f8f9ff !important;
        transform: scale(1.01);
        box-shadow: 0 0 20px rgba(102, 126, 234, 0.1);
    }

    /* Заголовок запроса */
    .request-title {
        font-size: 1rem;
        line-height: 1.5;
    }

    /* Статусы */
    .status-badge {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 50px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
    }

    .status-new {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .status-processing {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }

    .status-completed {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
    }

    .status-default {
        background: linear-gradient(135deg, #a8a8a8 0%, #7f7f7f 100%);
        color: white;
    }

    /* Пустое состояние */
    .empty-state {
        border: 2px dashed #dee2e6;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%) !important;
    }

    .empty-icon {
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-20px);
        }
    }

    /* Закругленные углы для карточки */
    .rounded-4 {
        border-radius: 1rem !important;
    }
</style>