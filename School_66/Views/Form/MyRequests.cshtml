@{
    ViewData["Title"] = "Мої запити";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model List<RequestViewModel>

<div class="container my-5">
    <h2 class="mb-4">Мої запити</h2>

    <table class="table table-striped table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">#</th>
                <th scope="col">Заголовок</th>
                <th scope="col">Тип</th>
                <th scope="col">Дата</th>
                <th scope="col">Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var request in Model)
            {
                <tr>
                    <td>@request.Id</td>
                    <td>@request.Title</td>
                    <td>@request.Type</td>
                    <td>@request.CreatedAt.ToString("dd.MM.yyyy")</td>
                    <td>
                        @if(request.Status == "Новий")
                        {
                            <span class="badge bg-primary">@request.Status</span>
                        }
                        else if(request.Status == "Обробляється")
                        {
                            <span class="badge bg-warning text-dark">@request.Status</span>
                        }
                        else if(request.Status == "Виконано")
                        {
                            <span class="badge bg-success">@request.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@request.Status</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>