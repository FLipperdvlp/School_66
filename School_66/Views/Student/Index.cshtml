@model School_66.Models.StudentViewModel
@{
    ViewData["Title"] = "Головна";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="form-wrapper">
                <div class="form-header text-center mb-5">
                    <div class="icon-box mx-auto mb-3">
                        <i class="bi bi-chat-dots-fill"></i>
                    </div>
                    <h1 class="display-5 fw-bold gradient-text mb-2">Запит для учнів</h1>
                    <p class="text-muted fs-5">Заповніть форму і ми зв'яжемося з вами найближчим часом</p>
                </div>

                <form action="/students/createformforstudent" method="post" class="modern-form">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" 
                                    class="form-control form-control-modern" 
                                    id="firstName" 
                                    name="FirstName" 
                                    value="@Model?.FirstName"
                                    placeholder="Ім'я" 
                                    required />
                                <label for="firstName">
                                    <i class="bi bi-person me-2"></i>Ім'я
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" 
                                    class="form-control form-control-modern" 
                                    id="lastName" 
                                    name="LastName" 
                                    value="@Model?.LastName"
                                    placeholder="Прізвище" 
                                    required />
                                <label for="lastName">
                                    <i class="bi bi-person-fill me-2"></i>Прізвище
                                </label>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-floating">
                                <input type="text" 
                                    class="form-control form-control-modern" 
                                    id="className" 
                                    name="ClassName" 
                                    value="@Model?.ClassName"
                                    placeholder="Клас" 
                                    required />
                                <label for="className">
                                    <i class="bi bi-mortarboard me-2"></i>Клас
                                </label>
                                <div class="form-text ps-3">Наприклад: 10-А</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold fs-5 mb-3">
                                <i class="fa-regular fa-comment-dots me-2"></i>Як з вами зв'язатися?
                            </label>
                            <div class="contact-grid">
                                <button type="button" class="contact-card" data-method="Telegram">
                                    <div class="contact-icon telegram">
                                        <i class="fa-brands fa-telegram"></i>
                                    </div>
                                    <span class="contact-label">Telegram</span>
                                    <div class="check-icon">
                                        <i class="fa-solid fa-check-circle"></i>
                                    </div>
                                </button>

                                <button type="button" class="contact-card" data-method="Email">
                                    <div class="contact-icon email">
                                        <i class="fa-brands fa-google"></i>
                                    </div>
                                    <span class="contact-label">Gmail</span>
                                    <div class="check-icon">
                                        <i class="fa-solid fa-check-circle"></i>
                                    </div>
                                </button>

                                <button type="button" class="contact-card" data-method="Phone">
                                    <div class="contact-icon phone">
                                        <i class="fa-solid fa-phone"></i>
                                    </div>
                                    <span class="contact-label">Телефон</span>
                                    <div class="check-icon">
                                        <i class="fa-solid fa-check-circle"></i>
                                    </div>
                                </button>
                            </div>
                            <input type="hidden" id="contactMethod" name="ContactMethod" value="@Model?.ContactMethod" />
                        </div>

                        <div class="col-12">
                            <div class="form-floating">
                                <label for="requestText">
                                    <i class="bi bi-pencil-square me-2"></i>Ваш запит:
                                </label>
                                <textarea class="form-control form-control-modern" 
                                        id="requestText" 
                                        name="RequestText" 
                                        placeholder="Ваш запит"
                                        style="height: 150px">@Model?.RequestText</textarea>
                            </div>
                        </div>

                        <div class="col-12 text-center mt-4">
                            <button type="submit" class="btn-submit">
                                <span class="btn-content">
                                    <i class="bi bi-send-fill me-2"></i>Відправити запит
                                </span>
                                <span class="btn-shimmer"></span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const contactCards = document.querySelectorAll('.contact-card');
            const contactMethodInput = document.getElementById('contactMethod');

            contactCards.forEach(card => {
                card.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    contactCards.forEach(c => c.classList.remove('active'));
                    this.classList.add('active');
                    
                    contactMethodInput.value = this.dataset.method;
                });
            });

            // Додаємо анімацію при фокусі на поля
            const formControls = document.querySelectorAll('.form-control-modern');
            formControls.forEach(control => {
                control.addEventListener('focus', function() {
                    this.parentElement.classList.add('focused');
                });
                
                control.addEventListener('blur', function() {
                    this.parentElement.classList.remove('focused');
                });
            });
        });
    </script>

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --secondary-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --success-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --telegram-color: #0088cc;
            --email-color: #ea4335;
            --phone-color: #34a853;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            background-attachment: fixed;
            min-height: 100vh;
        }

        .form-wrapper {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(10px);
            border-radius: 30px;
            padding: 3rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            animation: fadeInUp 0.6s ease-out;
        }

        .icon-box {
            width: 80px;
            height: 80px;
            background: var(--primary-gradient);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
            animation: pulse 2s ease-in-out infinite;
        }

        .gradient-text {
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .form-floating {
            position: relative;
            transition: all 0.3s ease;
        }

        .form-floating.focused {
            transform: translateY(-2px);
        }

        .form-control-modern {
            border: 2px solid #e0e7ff;
            border-radius: 15px;
            padding: 1rem 1.25rem;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #fafbff;
        }

        .form-control-modern:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.15);
            background: white;
        }

        .form-floating > label {
            padding: 1rem 1.25rem;
            color: #6b7280;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .contact-card {
            position: relative;
            background: white;
            border: 3px solid #e5e7eb;
            border-radius: 20px;
            padding: 1.5rem 1rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }

        .contact-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: var(--primary-gradient);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .contact-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        }

        .contact-card.active {
            border-color: #667eea;
            background: linear-gradient(135deg, #f0f4ff 0%, #e8edff 100%);
            transform: scale(1.05);
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }

        .contact-icon {
            position: relative;
            z-index: 1;
            width: 60px;
            height: 60px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            color: white;
            transition: all 0.3s ease;
        }

        .contact-icon.telegram {
            background: linear-gradient(135deg, #0088cc 0%, #00a0e9 100%);
        }

        .contact-icon.email {
            background: linear-gradient(135deg, #ea4335 0%, #ff6b6b 100%);
        }

        .contact-icon.phone {
            background: linear-gradient(135deg, #34a853 0%, #5cb85c 100%);
        }

        .contact-card:hover .contact-icon {
            transform: rotate(10deg) scale(1.1);
        }

        .contact-label {
            position: relative;
            z-index: 1;
            font-weight: 600;
            color: #374151;
            font-size: 0.95rem;
        }

        .check-icon {
            position: absolute;
            top: 10px;
            right: 10px;
            color: #667eea;
            font-size: 1.5rem;
            opacity: 0;
            transform: scale(0);
            transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            z-index: 2;
        }

        .contact-card.active .check-icon {
            opacity: 1;
            transform: scale(1);
        }

        .btn-submit {
            position: relative;
            background: var(--primary-gradient);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 1rem 3rem;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.5);
        }

        .btn-submit:active {
            transform: translateY(-1px);
        }

        .btn-content {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-shimmer {
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            animation: shimmer 3s infinite;
        }

        .form-text {
            color: #9ca3af;
            font-size: 0.875rem;
            margin-top: 0.5rem;
        }
    </style>
}